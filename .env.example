# =============================================================================
# FitCalc Hub — Environment Variables
# Copy this file to .env.local and fill in the values.
# =============================================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="FitCalc Hub"
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fitcalc_hub?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL=http://localhost:3000

# Google OAuth (Auth.js)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email Authentication (Auth.js — Resend / SMTP placeholder)
AUTH_EMAIL_SERVER_HOST=
AUTH_EMAIL_SERVER_PORT=587
AUTH_EMAIL_SERVER_USER=
AUTH_EMAIL_SERVER_PASSWORD=
AUTH_EMAIL_FROM="FitCalc Hub <noreply@fitcalchub.com>"

# Optional: Analytics / Monitoring (placeholders)
# NEXT_PUBLIC_GA_ID=
# SENTRY_DSN=
